rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spots — recurso comunitario. [AUDIT-RULES-001 C4 + A4-rules]
    //   - read:   cualquier autenticado (todos ven plazas cercanas).
    //   - create: sólo firmado con el propio uid (reportedBy == request.auth.uid). La ventana
    //             transitoria permisiva (2026-07-13, clientes que escribían displayName) se cerró
    //             el 2026-09-03 antes del primer release de producción: la DB se reseteó el 30-08
    //             y todos los clientes en campo firman con uid desde julio.
    //   - update: el dueño puede editar cualquier campo; CUALQUIER otro autenticado sólo puede
    //             tocar los contadores comunitarios (enRouteCount / acceptCount / rejectCount) y
    //             nunca reasignar reportedBy — cierra el "cualquiera reescribe el spot ajeno".
    //   - delete: el dueño, O cualquiera si el spot YA CADUCÓ (expiresAt < ahora) — un TTL
    //             server-side barato sin Cloud Functions que evita que la colección crezca sin fin.
    match /spots/{spotId} {
      allow read:   if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.reportedBy == request.auth.uid;

      allow update: if request.auth != null
                    && (
                         // El dueño edita libremente, pero no puede cambiar de dueño.
                         (resource.data.reportedBy == request.auth.uid
                          && request.resource.data.reportedBy == resource.data.reportedBy)
                         // Un tercero sólo puede tocar los contadores comunitarios.
                         || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['enRouteCount', 'acceptCount', 'rejectCount'])
                       );

      allow delete: if request.auth != null
                    && (resource.data.reportedBy == request.auth.uid
                        // .get(..,0): un spot sin expiresAt (legacy) cuenta como caducado.
                        || resource.data.get('expiresAt', 0) < request.time.toMillis());
    }

    // Perfil de usuario y todas sus subcollections — sólo el propio usuario.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /parkingHistory/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /zones/{zoneId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Coche compartido — el ESPEJO del grupo. [VEH-SHARED-001]
    //
    // La sesión personal (`users/{uid}/parkingHistory`) sigue siendo la fuente de verdad y no se
    // toca: aquí vive solo la proyección que el grupo puede ver, sin ruta, sin provenance de
    // detección y sin matrícula — lo garantiza el TIPO que la escribe, no estas reglas.
    //
    // La pertenencia es una SUBCOLECCIÓN y no un array, precisamente para que se pueda comprobar
    // aquí: `exists(.../members/{uid})` es una condición de regla; "el uid está en el array y solo
    // te has añadido a ti mismo" no lo es sin releer el array anterior, y dos personas uniéndose a
    // la vez se pisarían el documento del dueño.
    //
    // ⚠️ El tope de 4 miembros NO se puede comprobar aquí (las reglas no cuentan una colección): lo
    // impone el cliente al CREAR el código, que es el único momento en que alguien con permiso de
    // lectura sobre `members` decide si cabe uno más. Endurecerlo es trabajo de la Cloud Function
    // de la etapa 2, junto con el dedupe y el push.
    match /sharedCars/{carId} {
      function isMember() {
        return request.auth != null
               && exists(/databases/$(database)/documents/sharedCars/$(carId)/members/$(request.auth.uid));
      }
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isMember();
      // El id del documento ES el id del coche del dueño: compartir no re-keya nada.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.carId == carId;
      // El dueño edita lo suyo (nombre, código activo, pausa) y NUNCA puede cambiar de dueño.
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner();

      // Una persona escribe SU documento y el de nadie más. Entrar exige un invite vivo que
      // apunte a ESTE coche; el dueño se inscribe a sí mismo al crear el grupo.
      match /members/{uid} {
        function invite(code) {
          return get(/databases/$(database)/documents/sharedCarInvites/$(code)).data;
        }
        function holdsValidInvite(code) {
          return code is string
                 && exists(/databases/$(database)/documents/sharedCarInvites/$(code))
                 && invite(code).carId == carId
                 && invite(code).expiresAtMs > request.time.toMillis()
                 && (invite(code).claimedByUid == null
                     || invite(code).claimedByUid == request.auth.uid);
        }

        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/sharedCars/$(carId)/members/$(request.auth.uid));
        allow create, update: if request.auth != null
                              && uid == request.auth.uid
                              && request.resource.data.uid == request.auth.uid
                              && (
                                   get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid
                                   || holdsValidInvite(request.resource.data.inviteCode)
                                 );
        // Salir es cosa de uno; enseñar la puerta, del dueño.
        allow delete: if request.auth != null
                      && (uid == request.auth.uid
                          || get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid);
      }

      // Dónde está el coche AHORA. Lo escribe quien aparca, que puede ser cualquiera del grupo.
      match /state/{docId} {
        allow read, write: if isMember();
      }

      // El historial compartido: cada uno firma el suyo, todos lo leen, y solo el dueño borra.
      match /sessions/{sessionId} {
        allow read: if isMember();
        allow create, update: if isMember()
                              && request.resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null
                      && get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid;
      }
    }

    // El código ES el secreto: se lee de uno en uno, nunca se lista. [VEH-SHARED-001]
    //
    // `get` abierto a cualquier autenticado es deliberado —quien tiene el código puede mirar a qué
    // coche pertenece antes de entrar—, y `list` cerrado es lo que impide barrer la colección
    // entera. Un solo uso: el que entra solo puede escribir `claimedByUid` con SU uid, una vez.
    match /sharedCarInvites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.code == code;
      allow update: if request.auth != null
                    && (
                         resource.data.ownerUid == request.auth.uid
                         || (
                              resource.data.claimedByUid == null
                              && request.resource.data.claimedByUid == request.auth.uid
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid'])
                              && resource.data.expiresAtMs > request.time.toMillis()
                            )
                       );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Diagnostics — trazas de detección en campo (DET-LOG). Sólo el propio usuario escribe/lee
    // las suyas. Default OFF vía el flag de abajo; sin opt-in no se escribe nada.
    match /diagnostics/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Informes de problema enviados por el usuario desde Ajustes: cabecera + el log local
    // troceado en base64. Solo el dueño escribe y lee los suyos; se barren con la cuenta igual
    // que el resto de la telemetría. [SUPPORT-REPORT-SHIPS-THE-LOCAL-LOG-001]
    match /diagnostics_reports/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flag de diagnóstico por usuario. El cliente sólo LO LEE para auto-gatearse; el toggle
    // lo hace un admin (MCP / Admin SDK, que bypassa estas reglas), nunca el cliente. El BORRADO
    // sí es del dueño: eliminar la cuenta barre también su telemetría (RGPD art. 17).
    // [ACCOUNT-DELETE-SWEEPS-DIAGNOSTICS-001]
    match /diagnostics_config/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Índice de suscripciones a alertas de zona [ZONE-A-SPOT-TELLS-THE-SERVER-AND-THE-SERVER-TELLS-YOU-001]
    //
    // Colección de nivel superior porque la Cloud Function tiene que poder preguntar «¿quién tiene
    // una zona que contenga este punto?» ENTRE usuarios, y eso no se puede hacer con las zonas
    // metidas en subcolecciones privadas.
    //
    // ⛔⛔ **Un índice de dónde vive la gente NO se puede barrer.** Ese es el fallo que este ticket
    // podría tener y el que estas reglas existen para impedir: la consulta de la función es
    // `cells array-contains`, así que si un cliente pudiera hacerla sacaría las coordenadas de sus
    // vecinos.
    //
    // La lectura se permite SOLO acotada al propio uid, y eso NO reabre el barrido: Firestore exige
    // que una consulta se pueda demostrar permitida *antes* de ejecutarla, así que
    // `where('cells','array-contains',…)` es rechazada de plano — no puede probar que todos los
    // resultados serían tuyos. Solo pasa `where('uid','==',<el tuyo>)`.
    //
    // ⚠️ Y hace falta: sin leer tus propias filas no se pueden BORRAR las que sobran, que es
    // justo lo que pasa al perder Plus o al apagar una zona. Una primera versión puso
    // `read: if false` y dejaba al usuario recibiendo avisos de una zona que había apagado, desde
    // un servidor sin forma de enterarse.
    //
    // Escribir, solo lo tuyo. La comprobación va sobre el CAMPO `uid`, no sobre el id: un uid de
    // Firebase Auth no tiene formato garantizado, así que partir el id por `_` sería una regla que
    // depende de una convención de nombres. Y en un borrado `request.resource` es null — por eso
    // create/update y delete van aparte en vez de un `write` que fallaría al desuscribirse.
    match /zoneAlertSubs/{subId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Denegar cualquier otra colección no listada explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
