rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Spots — recurso comunitario. [AUDIT-RULES-001 C4 + A4-rules]
    //   - read:   cualquier autenticado (todos ven plazas cercanas).
    //   - create: sólo firmado con el propio uid (reportedBy == request.auth.uid). La ventana
    //             transitoria permisiva (2026-07-13, clientes que escribían displayName) se cerró
    //             el 2026-09-03 antes del primer release de producción: la DB se reseteó el 30-08
    //             y todos los clientes en campo firman con uid desde julio.
    //   - update: el dueño puede editar cualquier campo; CUALQUIER otro autenticado sólo puede
    //             tocar los contadores comunitarios (enRouteCount / acceptCount / rejectCount) y
    //             nunca reasignar reportedBy — cierra el "cualquiera reescribe el spot ajeno".
    //   - delete: el dueño, O cualquiera si el spot YA CADUCÓ (expiresAt < ahora) — un TTL
    //             server-side barato sin Cloud Functions que evita que la colección crezca sin fin.
    match /spots/{spotId} {
      allow read:   if request.auth != null;

      // ⛔ Publicar una plaza DISPARA una notificación a todo el que vigila esa celda, así que
      // `create` no es solo escribir: es hablarle al móvil de desconocidos. Firmar con tu uid no
      // basta como permiso para eso. [SEC-A-SPOT-IS-NOT-A-MEGAPHONE-001]
      //
      // El techo sale del código, no de la intuición: `SpotTtlPolicy.AUTO_SPOT_TTL_MS` son 2 h y
      // `PROVISIONAL_SPOT_TTL_MS` 12 min, así que 3 h deja sitio al desfase de reloj del cliente
      // —el `expiresAt` lo calcula ÉL— sin dejar publicar una plaza que grite durante un mes.
      // Si el TTL sube, este número sube con él, y por eso está escrito de dónde viene.
      //
      // ⛔ La lista de estados es una COPIA del enum `SpotStatus`, en otro lenguaje y sin
      // compilador que las ate — por eso la vigila `SpotStatusRulesParityGuardrailTest`. Aquí
      // faltó `RELEASING` durante tres días y la plaza del embarque no se publicó ni una vez: la
      // nominación es siempre la PRIMERA escritura de su documento, así que entra por ESTA puerta.
      // El denied era mudo (worker con reintentos, descartado al vencer su TTL en cola).
      // [SEC-A-RELEASING-SPOT-IS-DENIED-AT-THE-DOOR-001]
      //
      // `RETRACTED` NO está, y no es un olvido: una retractación sólo aterriza sobre un documento
      // que ya existe. Crear una plaza ya retirada es escribir una lápida.
      allow create: if request.auth != null
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.expiresAt is int
                    && request.resource.data.expiresAt > request.time.toMillis()
                    && request.resource.data.expiresAt < request.time.toMillis() + 3 * 60 * 60 * 1000
                    && request.resource.data.status in ['CONFIRMED', 'PROVISIONAL', 'RELEASING'];

      allow update: if request.auth != null
                    && (
                         // El dueño edita lo suyo, pero ni cambia de dueño ni estira la caducidad:
                         // `set()` sobre un doc que ya existe evalúa UPDATE, así que sin esto la
                         // puerta que cierra `create` se reabría por detrás — una plaza inmortal es
                         // un pin que nadie puede quitar del mapa de los demás.
                         // [SEC-AN-OWNER-CANNOT-MAKE-A-SPOT-IMMORTAL-001]
                         (resource.data.reportedBy == request.auth.uid
                          && request.resource.data.reportedBy == resource.data.reportedBy
                          && request.resource.data.expiresAt is int
                          && request.resource.data.expiresAt < request.time.toMillis() + 3 * 60 * 60 * 1000
                          // Los CUATRO estados: por aquí pasan la promoción `RELEASING →
                          // CONFIRMED` (el mecanismo entero de
                          // [SPOT-A-BOARDING-IS-NOT-A-DEPARTURE-001], un documento que cambia de
                          // estado y no dos plazas) y el reintento del worker sobre una nominación
                          // que ya se escribió, que `set()` evalúa como UPDATE.
                          && request.resource.data.status in ['CONFIRMED', 'PROVISIONAL', 'RELEASING', 'RETRACTED'])
                         // Un tercero sólo puede tocar los contadores comunitarios.
                         || request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['enRouteCount', 'acceptCount', 'rejectCount'])
                       );

      allow delete: if request.auth != null
                    && (resource.data.reportedBy == request.auth.uid
                        // .get(..,0): un spot sin expiresAt (legacy) cuenta como caducado.
                        || resource.data.get('expiresAt', 0) < request.time.toMillis());
    }

    // Perfil de usuario y todas sus subcollections — sólo el propio usuario.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /parkingHistory/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /zones/{zoneId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Coche compartido — el ESPEJO del grupo. [VEH-SHARED-001]
    //
    // La sesión personal (`users/{uid}/parkingHistory`) sigue siendo la fuente de verdad y no se
    // toca: aquí vive solo la proyección que el grupo puede ver.
    //
    // ⛔ Este comentario decía «sin ruta … lo garantiza el TIPO». Era cierto al escribirlo y dejó
    // de serlo con F8: `SharedCarSessionDto` tiene `routePolyline`. Lo correcto: la ruta viaja SOLO
    // si su autor la comparte (`shareRoutesInGroup`, decidido en `sharedCarMirrorPayload`), y lo
    // que sí garantiza el tipo —porque no tiene campo donde caber— es la ausencia de provenance de
    // detección y de matrícula. [PRIV-A-ROUTE-LEAVES-THE-PHONE-BY-ONE-DOOR-001]
    //
    // La pertenencia es una SUBCOLECCIÓN y no un array, precisamente para que se pueda comprobar
    // aquí: `exists(.../members/{uid})` es una condición de regla; "el uid está en el array y solo
    // te has añadido a ti mismo" no lo es sin releer el array anterior, y dos personas uniéndose a
    // la vez se pisarían el documento del dueño.
    //
    // ⚠️ El tope de 4 miembros NO se puede comprobar aquí (las reglas no cuentan una colección): lo
    // impone el cliente al CREAR el código, que es el único momento en que alguien con permiso de
    // lectura sobre `members` decide si cabe uno más. Endurecerlo sigue siendo trabajo de la etapa
    // 2, junto con el dedupe entre dos móviles del mismo grupo.
    match /sharedCars/{carId} {
      function isMember() {
        return request.auth != null
               && exists(/databases/$(database)/documents/sharedCars/$(carId)/members/$(request.auth.uid));
      }
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isMember();
      // El id del documento ES el id del coche del dueño: compartir no re-keya nada.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.carId == carId;
      // El dueño edita lo suyo (nombre, código activo, pausa) y NUNCA puede cambiar de dueño.
      allow update: if isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner();

      // Una persona escribe SU documento y el de nadie más. Entrar exige un invite vivo que
      // apunte a ESTE coche; el dueño se inscribe a sí mismo al crear el grupo.
      match /members/{uid} {
        function invite(code) {
          return get(/databases/$(database)/documents/sharedCarInvites/$(code)).data;
        }
        // ⛔ El código VIVO del coche es el que manda, no solo "existe y no ha expirado": un
        // código reemplazado por uno nuevo tiene que dejar de abrir la puerta aunque su documento
        // siga sin borrarse (un hipo de red, una carrera entre dos taps). Sin esto la promesa de
        // "un solo código vivo, el anterior muere" dependía enteramente de que ese borrado tuviera
        // éxito. [SEC-A-REPLACED-INVITE-STILL-OPENS-THE-DOOR-001]
        function carActiveInviteCode() {
          return get(/databases/$(database)/documents/sharedCars/$(carId)).data.get('inviteCode', null);
        }
        function holdsValidInvite(code) {
          return code is string
                 && exists(/databases/$(database)/documents/sharedCarInvites/$(code))
                 && invite(code).carId == carId
                 && invite(code).expiresAtMs > request.time.toMillis()
                 && (invite(code).claimedByUid == null
                     || invite(code).claimedByUid == request.auth.uid)
                 && code == carActiveInviteCode();
        }

        allow read: if request.auth != null
                    && exists(/databases/$(database)/documents/sharedCars/$(carId)/members/$(request.auth.uid));
        allow create: if request.auth != null
                      && uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && (
                           get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid
                           || holdsValidInvite(request.resource.data.inviteCode)
                         );
        // ⛔ El UPDATE no vuelve a pedir el invite: caduca en 24 h y el miembro tiene que poder
        // mantener SU propia ficha para siempre — el token de FCM rota en cada reinstalación, y sin
        // esto un móvil conservaría su sitio en el grupo y dejaría de recibir avisos en silencio.
        // Que el documento YA exista es la prueba de que la entrada ocurrió.
        // [SHARED-A-PARKING-TELLS-THE-GROUP-001]
        allow update: if request.auth != null
                      && uid == request.auth.uid
                      && request.resource.data.uid == request.auth.uid
                      && resource != null;
        // Salir es cosa de uno; enseñar la puerta, del dueño.
        allow delete: if request.auth != null
                      && (uid == request.auth.uid
                          || get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid);
      }

      // Dónde está el coche AHORA. Lo escribe quien aparca, que puede ser cualquiera del grupo —
      // pero EN SU NOMBRE. [SEC-A-MEMBER-CANNOT-SPEAK-FOR-THE-CAR-001]
      //
      // ⛔ `write: if isMember()` dejaba a cualquier miembro escribir una cabecera firmada por OTRO,
      // y desde el 16-09 esa escritura dispara un push a todo el grupo: un miembro podía anunciar
      // que Marta acaba de aparcar donde él quisiera. Ahora la firma tiene que ser suya.
      //
      // Y la excepción que el propio código necesita: al salir del grupo se BORRA el nombre de
      // quien se va (`clearMemberFromState`), así que un update que solo ponga a null los campos
      // que YA eran suyos también pasa.
      match /state/{docId} {
        // ⛔ El dueño se mira en el COCHE, no aquí: `isOwner()` compara `resource.data.ownerUid`, y
        // dentro de este match `resource` es el documento de ESTADO, que no tiene ese campo. Con
        // `isOwner()` el borrado se denegaba siempre y disolver un grupo dejaba la última posición
        // del coche huérfana. [PRIV-A-DISSOLVED-GROUP-LEAVES-ITS-HEAD-001]
        function carOwner() {
          return get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid;
        }

        /** Aparcar: firmas TÚ la cabecera. */
        function writesAsAuthor() {
          return request.resource.data.get('authorUid', '') == request.auth.uid;
        }

        /**
         * Llevarte el coche que dejó otro. Acotado a los cuatro campos de esa noticia: mirar solo
         * «¿está mi uid en movedByUid?» sobre el documento resultante dejaba firmar un `authorUid`
         * ajeno con posición inventada y colarse por esta puerta.
         * [SEC-A-MEMBER-CANNOT-SIGN-AS-ANOTHER-001]
         */
        function takesTheCar() {
          return resource != null
                 && request.resource.data.get('movedByUid', '') == request.auth.uid
                 && request.resource.data.get('isParked', true) == false
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['isParked', 'movedByUid', 'movedByName', 'updatedAtMs']);
        }

        /** Salir del grupo: te borras TU nombre. */
        function clearsOnlyTheirOwnName() {
          return resource != null
                 && (resource.data.get('authorUid', '') == request.auth.uid
                     || resource.data.get('movedByUid', '') == request.auth.uid)
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['authorName', 'movedByUid', 'movedByName']);
        }

        /**
         * Expulsar: el dueño borra el nombre de OTRO, y solo puede BORRARLO.
         * Sin esto, `removeMember` —que corre con la sesión del dueño— fallaba en silencio y el
         * expulsado se quedaba con su nombre en la tarjeta del grupo.
         * [PRIV-A-REMOVED-MEMBER-KEEPS-THEIR-NAME-ON-THE-CAR-001]
         */
        function ownerClearsNames() {
          return carOwner() == request.auth.uid
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['authorName', 'movedByUid', 'movedByName'])
                 && request.resource.data.get('authorName', null) == null
                 && request.resource.data.get('movedByName', null) == null;
        }

        allow read: if isMember();
        allow create, update: if isMember()
                              && (writesAsAuthor() || takesTheCar()
                                  || clearsOnlyTheirOwnName() || ownerClearsNames());
        allow delete: if request.auth != null && carOwner() == request.auth.uid;
      }

      // El historial compartido: cada uno firma el suyo y todos lo leen.
      //
      // ⛔ Borrar es de DOS: el dueño (disolver el grupo) y **el autor de la sesión**. Esto último
      // faltaba, y sin ello salir del grupo —o borrar la cuenta— dejaba tu recorrido dentro para
      // siempre: la ficha de miembro se iba y las sesiones se quedaban, firmadas por un uid que ya
      // no estaba. La regla no puede pedir `isMember()` para el autor, porque el barrido corre
      // JUSTO cuando esa pertenencia se está deshaciendo.
      // [PRIV-A-DELETED-ACCOUNT-LEAVES-TWO-TOKENS-BEHIND-001]
      match /sessions/{sessionId} {
        allow read: if isMember();
        allow create, update: if isMember()
                              && request.resource.data.authorUid == request.auth.uid;
        allow delete: if request.auth != null
                      && (
                           resource.data.authorUid == request.auth.uid
                           || get(/databases/$(database)/documents/sharedCars/$(carId)).data.ownerUid == request.auth.uid
                         );
      }
    }

    // El código ES el secreto: se lee de uno en uno, nunca se lista. [VEH-SHARED-001]
    //
    // `get` abierto a cualquier autenticado es deliberado —quien tiene el código puede mirar a qué
    // coche pertenece antes de entrar—, y `list` cerrado es lo que impide barrer la colección
    // entera. Un solo uso: el que entra solo puede escribir `claimedByUid` con SU uid, una vez.
    match /sharedCarInvites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.code == code;
      allow update: if request.auth != null
                    && (
                         resource.data.ownerUid == request.auth.uid
                         || (
                              resource.data.claimedByUid == null
                              && request.resource.data.claimedByUid == request.auth.uid
                              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid'])
                              && resource.data.expiresAtMs > request.time.toMillis()
                            )
                       );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Diagnostics — trazas de detección en campo (DET-LOG). Sólo el propio usuario escribe/lee
    // las suyas. Default OFF vía el flag de abajo; sin opt-in no se escribe nada.
    match /diagnostics/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Informes de problema enviados por el usuario desde Ajustes: cabecera + el log local
    // troceado en base64. Solo el dueño escribe y lee los suyos; se barren con la cuenta igual
    // que el resto de la telemetría. [SUPPORT-REPORT-SHIPS-THE-LOCAL-LOG-001]
    match /diagnostics_reports/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Flag de diagnóstico por usuario. El cliente sólo LO LEE para auto-gatearse; el toggle
    // lo hace un admin (MCP / Admin SDK, que bypassa estas reglas), nunca el cliente. El BORRADO
    // sí es del dueño: eliminar la cuenta barre también su telemetría (RGPD art. 17).
    // [ACCOUNT-DELETE-SWEEPS-DIAGNOSTICS-001]
    match /diagnostics_config/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if false;
    }

    // Índice de suscripciones a alertas de zona [ZONE-A-SPOT-TELLS-THE-SERVER-AND-THE-SERVER-TELLS-YOU-001]
    //
    // Colección de nivel superior porque la Cloud Function tiene que poder preguntar «¿quién tiene
    // una zona que contenga este punto?» ENTRE usuarios, y eso no se puede hacer con las zonas
    // metidas en subcolecciones privadas.
    //
    // ⛔⛔ **Un índice de dónde vive la gente NO se puede barrer.** Ese es el fallo que este ticket
    // podría tener y el que estas reglas existen para impedir: la consulta de la función es
    // `cells array-contains`, así que si un cliente pudiera hacerla sacaría las coordenadas de sus
    // vecinos.
    //
    // La lectura se permite SOLO acotada al propio uid, y eso NO reabre el barrido: Firestore exige
    // que una consulta se pueda demostrar permitida *antes* de ejecutarla, así que
    // `where('cells','array-contains',…)` es rechazada de plano — no puede probar que todos los
    // resultados serían tuyos. Solo pasa `where('uid','==',<el tuyo>)`.
    //
    // ⚠️ Y hace falta: sin leer tus propias filas no se pueden BORRAR las que sobran, que es
    // justo lo que pasa al perder Plus o al apagar una zona. Una primera versión puso
    // `read: if false` y dejaba al usuario recibiendo avisos de una zona que había apagado, desde
    // un servidor sin forma de enterarse.
    //
    // Escribir, solo lo tuyo. La comprobación va sobre el CAMPO `uid`, no sobre el id: un uid de
    // Firebase Auth no tiene formato garantizado, así que partir el id por `_` sería una regla que
    // depende de una convención de nombres. Y en un borrado `request.resource` es null — por eso
    // create/update y delete van aparte en vez de un `write` que fallaría al desuscribirse.
    match /zoneAlertSubs/{subId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // ⛔ SEPARADOS, porque preguntan cosas distintas y juntarlos costaba una fila ajena: en
      // `create` no existe `resource`, pero en `update` mirar solo lo que el escritor PROPONE deja
      // reescribir encima la suscripción de otro poniendo tu uid. El id es `{uid}_{zoneId}` y un
      // uid no es un secreto —viaja en cada plaza como `reportedBy`—, así que la víctima dejaba de
      // recibir sus avisos y su fila acababa con los tokens del atacante. Tres líneas más abajo,
      // `delete` ya lo hacía bien. [SEC-A-ZONE-ALERT-ROW-IS-ONLY-REWRITTEN-BY-ITS-OWNER-001]
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Denegar cualquier otra colección no listada explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
