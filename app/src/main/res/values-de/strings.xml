<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Benachrichtigung: Erkennungs-Vordergrunddienst -->
    <string name="notif_detection_title">Achte auf dein Auto</string>
    <!-- %1$s = Fahrzeugname (z. B. "Ford Focus") -->
    <string name="notif_detection_title_vehicle">Achte auf deinen %1$s</string>
    <string name="notif_detection_explainer">Ich erkenne automatisch, wenn du parkst, um deinen Stellplatz für die Community freizugeben. Minimaler Batterieverbrauch.</string>

    <!-- Benachrichtigung: Parkbestätigung -->
    <string name="notif_confirmation_title">Hast du geparkt?</string>
    <string name="notif_confirmation_title_vehicle">Hast du deinen %1$s geparkt?</string>
    <string name="notif_confirmation_title_vehicle_street">Hast du deinen %1$s in %2$s geparkt?</string>
    <string name="notif_confirmation_title_street">Hast du in %1$s geparkt?</string>
    <string name="notif_confirmation_text">Sieht aus, als hättest du geparkt. Bestätigen wir den Platz?</string>
    <string name="notif_action_yes_parked">Ja, ich habe geparkt</string>
    <!-- [DET-STOP-BUTTON-001] Way out of a trip the user does not want followed. -->
    <string name="notif_action_stop_detection">Erkennung stoppen</string>
    <string name="notif_action_no_not_parked">Nein, ich habe nicht geparkt</string>

    <!-- Benachrichtigung: Parken gespeichert -->
    <string name="notif_parking_saved_title">Parken gespeichert</string>
    <string name="notif_parking_saved_text">Ihr Auto wurde geparkt. Tippen Sie, um es auf der Karte zu sehen.</string>

    <!-- Benachrichtigung: Parken gespeichert + Abbrechen-Aktion (ersetzt die Eingabeaufforderung nach Auto-Bestätigung) -->
    <string name="notif_parking_saved_confirm_title">Fahrzeug geparkt</string>
    <string name="notif_parking_saved_confirm_title_vehicle">%1$s geparkt</string>
    <string name="notif_parking_saved_confirm_text">Tippen, um die Karte zu öffnen, oder abbrechen, wenn es nicht Ihr Fahrzeug war.</string>
    <string name="notif_action_confirm">Ja, bestätigen</string>
    <string name="notif_action_cancel_save">Nein, abbrechen</string>

    <!-- Benachrichtigung: Berechtigung während des laufenden Dienstes widerrufen -->
    <string name="notif_permission_revoked_title">Paparcar benötigt Berechtigungen</string>
    <string name="notif_permission_revoked_text">Standortberechtigung widerrufen — tippen zum Wiederherstellen</string>

    <!-- Benachrichtigung: Fehler beim Speichern des Parkplatzes -->
    <string name="notif_confirmation_failed_title">Parken nicht gespeichert</string>
    <string name="notif_confirmation_failed_text">Parkplatz konnte nicht gespeichert werden. Öffne Paparcar, um es erneut zu versuchen.</string>

    <!-- Benachrichtigung: Debug (nur Entwicklungs-Builds) -->
    <string name="notif_debug_title">Paparcar Debug</string>

    <!-- Namen und Beschreibungen der Benachrichtigungskanäle -->
    <string name="channel_detection_name">Stellplatzerkennung</string>
    <string name="channel_detection_desc">Dauerhafte Benachrichtigung während der Parkerkennung aktiv ist</string>
    <string name="channel_upload_name">Stellplatz-Upload</string>
    <string name="channel_upload_desc">Bestätigungen für gespeicherte Stellplätze und Cloud-Upload</string>
    <string name="channel_action_name">Parkbestätigung</string>
    <string name="channel_action_desc">Fragt dich, ob du geparkt hast</string>
    <string name="channel_debug_name">Debug</string>
    <string name="channel_debug_desc">Debug-Meldungen — nur in Entwicklungs-Builds</string>

    <string name="attribution_detection_label">Parkerkennung</string>

    <!-- Notification: Watchdog „noch geparkt?" (vermutlich verpasster Geofence-Ausgang) -->
    <string name="notif_still_parked_title">Noch hier geparkt?</string>
    <string name="notif_still_parked_text">Du scheinst weg zu sein, aber dieser Parkplatz ist noch offen. Sag uns, ob du schon losgefahren bist, oder markiere, wo das Auto jetzt steht.</string>
    <!-- DET-TOGGLE-002: cold-start nudge -->
    <string name="notif_first_park_nudge_title">Einmal parken, um die Erkennung zu starten</string>
    <string name="notif_first_park_nudge_text">Parke einmal mit Paparcar; danach geben wir deinen Platz bei jeder Abfahrt automatisch frei.</string>
    <string name="notif_first_park_nudge_action">Platz markieren</string>
    <!-- DET-AR-FIRST-001 -->
    <string name="notif_mark_parking_title">Wo hast du dein Auto abgestellt?</string>
    <string name="notif_mark_parking_text">Wir haben erkannt, dass du dich bewegt hast, konnten aber nicht bestimmen, wo dein Auto geblieben ist. Markiere den Platz, damit er nicht verloren geht.</string>
    <string name="notif_mark_parking_action">Platz markieren</string>
    <string name="notif_action_ive_left">Ich bin weg</string>
    <string name="notif_action_mark_parking">Parkplatz markieren</string>
    <string name="notif_background_kill_title">Dein Handy blockiert Paparcar</string>
    <string name="notif_background_kill_text">Das System hat die Parkerkennung im Hintergrund stundenlang pausiert. Tippe, um die App zu öffnen und es unter Einstellungen → Erkennung zu beheben.</string>
    <string name="notif_sentry_title">Geparkt · achte auf deine Abfahrt</string>
    <string name="notif_sentry_text">Wenn du losfährst, geben wir deinen Parkplatz für andere frei. Lautlos, minimaler Akkuverbrauch. In den Einstellungen abschaltbar.</string>
    <string name="channel_sentry_name">Park-Überwachung</string>
    <string name="channel_sentry_desc">Stille Benachrichtigung, während dein Auto geparkt ist</string>
</resources>
