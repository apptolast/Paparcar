<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Notification: detection foreground service.
         [COPY-THE-SERVICE-NOTIFICATION-IS-ONE-LINE-001] The title IS the whole collapsed row: these
         ongoing notifications carry no contentText, so this one string has to say the only thing the
         user cannot work out alone — WHAT is being watched. Budget ~36 chars, measured in the
         longest language (DE/PL), never in EN or ES. The "what it does + battery" sentence lives in
         `notif_detection_explainer` and shows only when the row is expanded. -->
    <string name="notif_detection_title">Watching your car</string>
    <!-- %1$s = vehicle name (e.g. "Ford Focus") -->
    <string name="notif_detection_title_vehicle">Watching your %1$s</string>
    <string name="notif_detection_explainer">I automatically detect when you park to free your spot for the community. Minimal battery use.</string>

    <!-- Notification: parking confirmation prompt -->
    <string name="notif_confirmation_title">Did you park?</string>
    <string name="notif_confirmation_title_vehicle">Did you park your %1$s?</string>
    <string name="notif_confirmation_title_vehicle_street">Did you park your %1$s at %2$s?</string>
    <string name="notif_confirmation_title_street">Did you park at %1$s?</string>
    <string name="notif_confirmation_text">Looks like you parked. Shall we confirm your parking?</string>
    <string name="notif_action_yes_parked">Yes, I parked</string>
    <!-- [DET-STOP-BUTTON-001] Way out of a trip the user does not want followed. -->
    <string name="notif_action_stop_detection">Stop detection</string>
    <string name="notif_action_no_not_parked">No, I haven\'t parked</string>

    <!-- Notification: parking saved (user's own car) -->
    <string name="notif_parking_saved_title">Parking saved</string>
    <string name="notif_parking_saved_text">Your car has been parked. Tap to see it on the map.</string>

    <!-- Notification: parking saved + revert action (replaces the prompt after auto-confirm) -->
    <string name="notif_parking_saved_confirm_title">Vehicle parked</string>
    <!-- %1$s = vehicle name (e.g. "Ford Focus") -->
    <string name="notif_parking_saved_confirm_title_vehicle">%1$s parked</string>
    <string name="notif_parking_saved_confirm_text">Tap to open the map, or cancel if it wasn\'t your vehicle.</string>
    <string name="notif_action_confirm">Yes, confirm</string>
    <string name="notif_action_cancel_save">No, cancel</string>

    <!-- Notification: permission revoked while service was running -->
    <string name="notif_permission_revoked_title">Paparcar needs permissions</string>
    <string name="notif_permission_revoked_text">Location permission revoked — tap to restore</string>

    <!-- Notification: confirmation failed (exceptional error path) -->
    <string name="notif_confirmation_failed_title">Parking not saved</string>
    <string name="notif_confirmation_failed_text">Could not save your parking. Open Paparcar to try again.</string>

    <!-- Notification: OEM background-kill warning [OEM-KILL-001] -->
    <string name="notif_background_kill_title">Your phone is blocking Paparcar</string>
    <string name="notif_background_kill_text">The system paused parking detection in the background for hours. Tap to open the app and fix it in Settings → Detection.</string>

    <!-- Notification: watchdog "still parked?" prompt (suspected missed geofence exit) -->
    <string name="notif_still_parked_title">Still parked here?</string>
    <string name="notif_still_parked_text">You seem to be away, but this parking is still open. Tell us if you already left, or mark where the car is now.</string>
    <!-- DET-TOGGLE-002: cold-start nudge -->
    <string name="notif_first_park_nudge_title">Park once to start auto-detection</string>
    <string name="notif_first_park_nudge_text">Park with Paparcar once — after that we free your spot automatically every time you leave.</string>
    <string name="notif_first_park_nudge_action">Mark parking</string>
    <!-- DET-AR-FIRST-001: unattended session ended without measured driving — ask where the car is -->
    <string name="notif_mark_parking_title">Where did you leave your car?</string>
    <string name="notif_mark_parking_text">We noticed you moved, but we couldn\'t pin where your car ended up. Mark your parking so you don\'t lose it.</string>
    <string name="notif_mark_parking_action">Mark parking</string>
    <string name="notif_action_ive_left">I\'ve left</string>
    <string name="notif_action_mark_parking">Mark parking</string>

    <!-- Notification: debug (dev builds only) -->
    <string name="notif_debug_title">Paparcar Debug</string>

    <!-- Attribution tag label (required as resource reference by PackageParser) -->
    <string name="attribution_detection_label">Parking detection</string>

    <!-- Notification channel names and descriptions -->
    <string name="channel_detection_name">Spot Detection</string>
    <string name="channel_detection_desc">Persistent notification while parking detection is active</string>
    <string name="channel_upload_name">Parking &amp; Spots</string>
    <string name="channel_upload_desc">Parking saved and spot upload confirmations</string>
    <string name="channel_action_name">Parking confirmation</string>
    <string name="channel_action_desc">Asks you to confirm whether you have parked</string>
    <string name="channel_debug_name">Debug</string>
    <string name="channel_debug_desc">Debug messages — development builds only</string>
    <!-- Same one-line rule as `notif_detection_title`: driving, we watch the car; parked, we watch
         for the departure. `notif_sentry_text` below is the expanded explainer, not a second line. -->
    <string name="notif_sentry_title">Parked · watching for your departure</string>
    <string name="notif_sentry_text">When you drive off we\'ll free your spot for others. Quiet, minimal battery. Turn off in Settings.</string>
    <string name="channel_sentry_name">Parked watch</string>
    <string name="channel_sentry_desc">Silent notification shown while your car is parked</string>
    <!-- Plus zone alert [MONEY-001] -->
    <string name="notif_zone_spot_title">Free spot in %1$s</string>
    <string name="notif_zone_spot_text">Someone just left — open the map to see it</string>
    <string name="notif_zone_spot_text_provisional">Someone may have just left — open the map, it is not confirmed yet</string>

    <!-- [FUEL-A-PRICE-REMEMBERED-IS-A-PRICE-THAT-CAN-MOVE-001] Plus fuel alerts. The saving always
         names what it is measured against: a bare "8 c/l cheaper" is a number nobody can check. -->
    <string name="notif_fuel_cheaper_title_named">%1$s is cheaper</string>
    <string name="notif_fuel_cheaper_title">A cheaper station nearby</string>
    <string name="notif_fuel_cheaper_text">%1$s less per litre than %2$s</string>
    <string name="notif_fuel_reference_area">the usual price nearby</string>
    <string name="notif_fuel_move_title_named">%1$s changed its price</string>
    <string name="notif_fuel_move_title">A station you follow changed its price</string>
    <string name="notif_fuel_move_text_down">%1$s cheaper per litre than yesterday</string>
    <string name="notif_fuel_move_text_up">%1$s dearer per litre than yesterday</string>
    <string name="notif_fuel_move_text_down_more">%1$s cheaper per litre than yesterday · %2$s more changed</string>
    <string name="notif_fuel_move_text_up_more">%1$s dearer per litre than yesterday · %2$s more changed</string>

    <!-- Home-screen widget [WIDGET-PARKED-001] -->
    <string name="widget_label">Parked car</string>
    <string name="widget_description">See where you left your car, at a glance</string>
    <string name="widget_empty_title">No car parked</string>
    <string name="widget_empty_hint">Park and this widget will show where</string>
    <string name="widget_driving_title">%1$s · On the way</string>
    <string name="widget_driving_title_unknown">On the way</string>
    <string name="widget_driving_parking">Parking…</string>
    <string name="widget_driving_hint">Your parking will show up here</string>
    <string name="widget_location_pending">Location saved</string>
    <string name="widget_more_parked">+%1$d more</string>
    <!-- Widget actions [WIDGET-ACTIONS-002] — same wording as in-app -->
    <string name="widget_action_navigate">Directions</string>
    <string name="widget_action_more">More options</string>
</resources>
