<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de localización -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service -->
    <!-- [DET-SAFETY-NET-FGS-IS-TYPED-DATA-SYNC-001] Declaramos sólo LOCATION, que es el único tipo
         que esta app USA — incluido el foreground service que WorkManager levanta para
         ParkingSafetyNetWorker (ver el tools:node="merge" más abajo).

         ⚠️ FOREGROUND_SERVICE_DATA_SYNC ya no se declara aquí, pero SIGUE APARECIENDO en el
         manifiesto fusionado: lo inyecta AGP 9.3.2 después del merge. Verificado — ninguna de las
         1.095 dependencias lo declara, el blame del merger no lo atribuye a nadie, y ni borrarlo de
         aquí ni un tools:node="remove" lo eliminan. No está bajo nuestro control; lo que sí lo está
         es que nuestro manifiesto deje de reclamarlo. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Activity Recognition -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reinicio al arrancar dispositivo (para reactivar acelerómetro) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth — needed to read paired device names/addresses (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Battery optimization — allows requesting exemption via system dialog [DOZE-001] -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Exact-alarm polling net while parked (Doze-piercing safety-net trigger). Auto-granted up
         to targetSdk 32; user-revocable "Alarms & reminders" special access from 33+ — the
         scheduler gates on canScheduleExactAlarms() and degrades to inexact. [DET-EXACT-HEARTBEAT-001] -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Attribution tag required by ActivityRecognition.getClient(createAttributionContext(...))
         to avoid "attributionTag not declared in manifest" AppOps leak. [FGS-004] -->
    <attribution android:tag="detection" android:label="@string/attribution_detection_label" />

    <!-- [IOS-F0-07] Backup stays ON (user settings + the parked-car pin survive a device
         migration) but detection state is excluded — restored anchors/pendings/heartbeats on a
         new device are ghost state. Rules in res/xml (dataExtractionRules API 31+,
         fullBackupContent API 26-30). -->
    <application
        android:name=".PaparcarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="Paparcar"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Paparcar.Starting"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [DET-SAFETY-NET-FGS-IS-TYPED-DATA-SYNC-001] El foreground service que WorkManager
             levanta para el trabajo expedited. Su AAR (androidx.work 2.11.2) lo declara SIN
             foregroundServiceType, y el tipo que se pasa en runtime tiene que estar declarado aquí
             o la promoción falla en Android 14+. Su único cliente es ParkingSafetyNetWorker, que
             pide un fix GPS → location. Si algún día otro worker se promueve a foreground haciendo
             algo que no sea ubicación, este tipo se queda corto: es un servicio COMPARTIDO. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="location"
            tools:node="merge" />

        <!-- CoordinatorDetectionService — Coordinator (Activity Recognition) path -->
        <service
            android:name=".detection.service.CoordinatorDetectionService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- BluetoothDetectionService — BT disconnect path [BT-REFACTOR-FGS-001]
             foregroundServiceType="location" required for GPS access while running in
             background (30 s debounce + 60 s GPS sampling + distance watch). -->
        <service
            android:name=".bluetooth.BluetoothDetectionService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- ActivityTransitionReceiver -->
        <receiver
            android:name=".detection.receiver.ActivityTransitionReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION">
        </receiver>

        <!-- BootCompletedReceiver — re-arms geofences/AR/workers after the events that wipe them:
             reboot, app update (MY_PACKAGE_REPLACED drops Play Services geofences) and, on
             Android 15+, the synthetic BOOT_COMPLETED delivered when leaving the force-stopped
             state. [GEOF-RESTORE-001] -->
        <receiver
            android:name=".detection.receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Google Maps API Key — value injected at build time via manifestPlaceholders in build.gradle.kts -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- BluetoothConnectionReceiver — ACL connect/disconnect events for BT parking detection.
             MUST be exported: ACL broadcasts are sent by the Bluetooth stack process (uid
             `bluetooth`, not `system`), which cannot deliver to non-exported components of
             another app — exported="false" left this receiver permanently deaf and the whole
             deterministic BT strategy dead. Safe to export: both ACL actions are protected
             broadcasts (only the system/BT stack may send them), and the android:permission
             guard additionally restricts senders to BLUETOOTH_CONNECT holders.
             [DET-BT-RECEIVER-EXPORT-001] -->
        <receiver
            android:name=".bluetooth.BluetoothConnectionReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- GeofenceEnterReceiver — twin ENTER fence: the user walked back to the parked car;
             enqueues the safety-net check that re-seals the anchor + cures the EXIT fence state.
             Explicit PendingIntent target, no intent-filter. [DET-RETURN-ANCHOR-001] -->
        <receiver
            android:name=".detection.receiver.GeofenceEnterReceiver"
            android:exported="false" />

        <!-- GeofenceExitWitnessReceiver — pure-logging witness of every EXIT emission, to tell
             "Play Services never emitted" apart from "emitted but the privileged service start
             was swallowed". Decision-free. [DET-EXIT-WITNESS-001] -->
        <receiver
            android:name=".detection.receiver.GeofenceExitWitnessReceiver"
            android:exported="false" />

        <!-- ExactHeartbeatReceiver — exact-alarm tick of the parked polling net: enqueues the
             standard safety-net check and re-arms the next tick. Explicit PendingIntent target,
             no intent-filter. [DET-EXACT-HEARTBEAT-001] -->
        <receiver
            android:name=".detection.receiver.ExactHeartbeatReceiver"
            android:exported="false" />

        <!-- ParkingConfirmationReceiver — notification action buttons.
             Pre-save prompt: CONFIRMED / DENIED.
             Post-save card  : ACK / REVERT  [REFACTOR-300] -->
        <receiver
            android:name=".detection.receiver.ParkingConfirmationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_CONFIRMED" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_DENIED" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_ACK" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_REVERT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
