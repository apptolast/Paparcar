<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de localización -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service -->
    <!-- [DET-SAFETY-NET-FGS-IS-TYPED-DATA-SYNC-001] Declaramos sólo LOCATION, que es el único tipo
         que esta app USA — incluido el foreground service que WorkManager levanta para
         ParkingSafetyNetWorker (ver el tools:node="merge" más abajo).

         Nota histórica [FGS-DATA-SYNC-IS-NO-LONGER-INJECTED-001]: con AGP 9.3.2, retirar
         FOREGROUND_SERVICE_DATA_SYNC de aquí NO lo quitaba del manifiesto fusionado — lo reinyectaba
         AGP después del merge (ninguna de las 1.095 dependencias lo declaraba, el blame del merger
         no se lo atribuía a nadie, y ni un tools:node="remove" lo eliminaba). Con AGP 9.4.0 ya NO
         aparece: medido el 16-09-2026 en los manifiestos fusionados prodDebug/prodRelease
         (processProd*MainManifest forzado con rerun-tasks, porque un artefacto incremental no sirve
         de prueba), en el blame del merger, en los dos APK vía `aapt2 dump permissions` y en el AAB.
         ⛔ Dentro de un comentario XML no caben dos guiones seguidos: por eso el flag va escrito sin
         ellos. Con el flag literal, processProdReleaseMainManifest falla al parsear este fichero.
         Si algún día reaparece, eso es lo que hay que volver a medir. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Activity Recognition -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Reinicio al arrancar dispositivo (para reactivar acelerómetro) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth is optional: Coordinator and manual parking also work without it. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- Legacy Bluetooth access is required through Android 11. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Bluetooth — needed to read paired device names/addresses (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Battery optimization — allows requesting exemption via system dialog [DOZE-001] -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Exact-alarm polling net while parked (Doze-piercing safety-net trigger). Auto-granted up
         to targetSdk 32; user-revocable "Alarms & reminders" special access from 33+ — the
         scheduler gates on canScheduleExactAlarms() and degrades to inexact. [DET-EXACT-HEARTBEAT-001] -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Identificador de publicidad. Hasta la 1.5.0 los tres se BORRABAN del manifiesto fusionado
         (play-services-measurement los mete por su cuenta) y la ficha prometía «sin anuncios»
         [ANALYTICS-EVENTS-001]. Vuelven porque Paparcar se anuncia en Meta, y sin el GAID la
         atribución de instalaciones no existe: el SDK mandaría eventos que nadie puede casar con
         el anuncio que los pagó. [MKT-META-APP-EVENTS-COST-THE-NO-ADS-PROMISE-001]

         ⛔ Un permiso declarado NO es un permiso usado por todos. El único carril que lo recoge es
         Meta App Events (`MetaAdAttribution.activate`, y sólo con consentimiento legal); Firebase
         Analytics lo sigue teniendo prohibido con `google_analytics_adid_collection_enabled`
         abajo, así que los eventos de producto siguen anclados al app-instance id, como estaban.
         Declarados explícitamente para que `aapt2 dump permissions` diga lo que el formulario de
         Data Safety declara, en vez de depender de lo que fusione una dependencia. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" />

    <!-- ⛔ Y hasta ahí. `facebook-core` fusiona además las DOS APIs de Privacy Sandbox que sirven
         para SEGMENTAR, no para medir: Topics (los intereses que el sistema te infiere) y Custom
         Audience (remarketing). Medido en el manifiesto fusionado de prodDebug el 02-11-2026 —
         entran solas, sin que nadie las pida.

         Paparcar no hace ninguna de las dos cosas: lo que la política publicada declara son tres
         nombres de evento y el identificador de publicidad, «y nada más». Dejarlas entrar haría
         que el binario pudiera más de lo que el documento dice, que es exactamente el defecto que
         este ticket viene a cerrar. [MKT-META-APP-EVENTS-COST-THE-NO-ADS-PROMISE-001] -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />

    <!-- Attribution tag required by ActivityRecognition.getClient(createAttributionContext(...))
         to avoid "attributionTag not declared in manifest" AppOps leak. [FGS-004] -->
    <attribution android:tag="detection" android:label="@string/attribution_detection_label" />

    <!-- [ONBOARDING-A-TUTORIAL-IS-REMEMBERED-BY-THE-ACCOUNT-NOT-THE-DEVICE-001] Nothing local is
         backed up, and nothing is device-transferred. Everything that matters about an account
         lives in Firestore and comes back with the login; what Auto Backup used to carry — the
         DataStore, the detection SharedPreferences and the Room cache — is state of an INSTALL,
         and restoring it into a new one is how a user who uninstalled to start clean got the
         guided tutorial back halfway through, on data that install never produced. The price is
         theme / units / map type not following the user to a new phone. -->
    <application
        android:name=".PaparcarApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Paparcar"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Paparcar.Starting"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- [DET-SAFETY-NET-FGS-IS-TYPED-DATA-SYNC-001] El foreground service que WorkManager
             levanta para el trabajo expedited. Su AAR (androidx.work 2.11.2) lo declara SIN
             foregroundServiceType, y el tipo que se pasa en runtime tiene que estar declarado aquí
             o la promoción falla en Android 14+. Su único cliente es ParkingSafetyNetWorker, que
             pide un fix GPS → location. Si algún día otro worker se promueve a foreground haciendo
             algo que no sea ubicación, este tipo se queda corto: es un servicio COMPARTIDO. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="location"
            tools:node="merge" />

        <!-- CoordinatorDetectionService — Coordinator (Activity Recognition) path -->
        <service
            android:name=".detection.service.CoordinatorDetectionService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- BluetoothDetectionService retired: the BT lane (hunt + departure watch) rides the
             sentinel above since [DET-ONE-SERVICE-TWO-LANES-001]. -->

        <!-- Zone alert push. [ZONE-A-SPOT-TELLS-THE-SERVER-AND-THE-SERVER-TELLS-YOU-001]
             Replaces the 15-minute poll: a Cloud Function tells the phone when a spot lands inside
             one of its zones, which is the only way to be told while the app is not running.
             ⛔ exported="false" WITH an intent filter, which looks contradictory and is not: only
             the Firebase messaging library in this same process dispatches MESSAGING_EVENT, so
             nothing external needs to reach it. Exporting it would let any app on the device fire a
             fake zone alert at the user. -->
        <service
            android:name="com.rndeveloper.paparcar.push.PaparcarMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ActivityTransitionReceiver -->
        <receiver
            android:name=".detection.receiver.ActivityTransitionReceiver"
            android:exported="true"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION">
        </receiver>

        <!-- [WIDGET-PARKED-001] Home-screen widget del aparcamiento activo. exported=false: el
             sistema entrega APPWIDGET_UPDATE igualmente; nadie más tiene que poder. -->
        <receiver
            android:name=".widget.ParkedWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parked_widget_info" />
        </receiver>

        <!-- BootCompletedReceiver — re-arms geofences/AR/workers after the events that wipe them:
             reboot, app update (MY_PACKAGE_REPLACED drops Play Services geofences) and, on
             Android 15+, the synthetic BOOT_COMPLETED delivered when leaving the force-stopped
             state. [GEOF-RESTORE-001] -->
        <receiver
            android:name=".detection.receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Google Maps API Key — value injected at build time via manifestPlaceholders in build.gradle.kts -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- BluetoothConnectionReceiver — ACL connect/disconnect events for BT parking detection.
             MUST be exported: ACL broadcasts are sent by the Bluetooth stack process (uid
             `bluetooth`, not `system`), which cannot deliver to non-exported components of
             another app — exported="false" left this receiver permanently deaf and the whole
             deterministic BT strategy dead. Safe to export: both ACL actions are protected
             broadcasts (only the system/BT stack may send them), and the android:permission
             guard additionally restricts senders to BLUETOOTH_CONNECT holders.
             [DET-BT-RECEIVER-EXPORT-001] -->
        <receiver
            android:name=".bluetooth.BluetoothConnectionReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- GeofenceEnterReceiver — twin ENTER fence: the user walked back to the parked car;
             enqueues the safety-net check that re-seals the anchor + cures the EXIT fence state.
             Explicit PendingIntent target, no intent-filter. [DET-RETURN-ANCHOR-001] -->
        <receiver
            android:name=".detection.receiver.GeofenceEnterReceiver"
            android:exported="false" />

        <!-- GeofenceExitWitnessReceiver — pure-logging witness of every EXIT emission, to tell
             "Play Services never emitted" apart from "emitted but the privileged service start
             was swallowed". Decision-free. [DET-EXIT-WITNESS-001] -->
        <receiver
            android:name=".detection.receiver.GeofenceExitWitnessReceiver"
            android:exported="false" />

        <!-- ExactHeartbeatReceiver — exact-alarm tick of the parked polling net: enqueues the
             standard safety-net check and re-arms the next tick. Explicit PendingIntent target,
             no intent-filter. [DET-EXACT-HEARTBEAT-001] -->
        <receiver
            android:name=".detection.receiver.ExactHeartbeatReceiver"
            android:exported="false" />

        <!-- ParkingConfirmationReceiver — notification action buttons.
             Pre-save prompt: CONFIRMED / DENIED.
             Post-save card  : ACK / REVERT  [REFACTOR-300] -->
        <receiver
            android:name=".detection.receiver.ParkingConfirmationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_CONFIRMED" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_DENIED" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_ACK" />
                <action android:name="com.rndeveloper.paparcar.ACTION_PARKING_REVERT" />
            </intent-filter>
        </receiver>

        <!-- Firebase Analytics NO recoge el identificador de publicidad, aunque el permiso exista
             por el carril de Meta: los eventos de producto siguen identificados sólo por el
             app-instance id. [ANALYTICS-EVENTS-001, MKT-META-APP-EVENTS-COST-THE-NO-ADS-PROMISE-001] -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />

        <!-- Meta App Events. Los ids entran por `manifestPlaceholders` desde `local.properties`,
             como la clave de Maps: en un clon sin claves quedan vacíos y el carril no arranca.

             ⛔ Los tres automatismos arrancan APAGADOS y es lo único que hace que esta app pueda
             prometer que no manda nada sin consentimiento: con `AutoInitEnabled` a `true` el
             ContentProvider del SDK inicializa y hace `activateApp` ANTES de que corra una línea
             nuestra. Los enciende `MetaAdAttribution.activate`, con el consentimiento legal ya
             aceptado. [MKT-META-APP-EVENTS-COST-THE-NO-ADS-PROMISE-001] -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="${FACEBOOK_APP_ID}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${FACEBOOK_CLIENT_TOKEN}" />
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

    </application>
</manifest>
