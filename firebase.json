{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "debug",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": {
    "public": "hosting/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "**/*.local",
        "src",
        "**/*.test.ts",
        "lib/**/*.test.js",
        "lib/**/*.test.js.map"
      ]
    }
  ]
}
