# Appfile — fixed identifiers for the iOS side of Paparcar (KMP).
# Adapted from Munición's, which shares the team, the match repo and the App Store Connect API key.
# Per-developer paths and credentials come from `iosApp/fastlane/.env` (gitignored).
# [IOS-APPLE-SIGN-IN-ON-BASELOGIN-3-001]

# Must match PRODUCT_BUNDLE_IDENTIFIER in iosApp/Configuration/Config.xcconfig.
app_identifier("com.rndeveloper.paparcar")

apple_id(ENV["APPLE_ID"]) unless ENV["APPLE_ID"].to_s.empty?
team_id(ENV["FASTLANE_TEAM_ID"]) unless ENV["FASTLANE_TEAM_ID"].to_s.empty?
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) unless ENV["FASTLANE_ITC_TEAM_ID"].to_s.empty?
